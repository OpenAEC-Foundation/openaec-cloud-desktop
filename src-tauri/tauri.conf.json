{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAEC Desktop App",
  "version": "2026.44.5",
  "identifier": "com.openaec.cloud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenAEC Desktop App",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "label": "main"
      },
      {
        "title": "OpenAEC Desktop App – status",
        "label": "status",
        "url": "status.html",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "title": "Delen – OpenAEC Desktop App",
        "label": "delen",
        "url": "delen.html",
        "width": 520,
        "height": 720,
        "minWidth": 440,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "title": "Versturen met OpenAEC",
        "label": "versturen",
        "url": "versturen.html",
        "width": 520,
        "height": 620,
        "minWidth": 460,
        "minHeight": 540,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "WebView2Loader.dll"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "version": "26.44.5",
        "upgradeCode": "05e45fa2-f31f-52e2-b4e8-f0b880688a57"
      }
    },
    "shortDescription": "Projectbestanden synchroniseren en delen, en OpenAEC-tools installeren",
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OpenAEC-Foundation/openaec-cloud-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1Nzg3M0JEQzQxRTNBQjQKUldTME9oN0V2WE40OWZRMCs3eHNSQkxhTEhuOHp1Q0s4dWdOKzJaQXFmK3NQdFJyMCtVTjhDSU8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}