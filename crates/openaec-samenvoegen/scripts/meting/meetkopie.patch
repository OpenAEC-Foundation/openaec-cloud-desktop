+/// Meetkopie: tijd sinds de vorige fase en het geheugen nu (VmRSS) en de piek (VmHWM), naar stderr.
+pub fn fase(naam: &str) {
+    use std::sync::Mutex;
+    use std::time::Instant;
+    static VORIGE: Mutex<Option<Instant>> = Mutex::new(None);
+    let mut v = VORIGE.lock().unwrap();
+    let nu = Instant::now();
+    let dt = v.map(|t| nu.duration_since(t).as_secs_f64()).unwrap_or(0.0);
+    *v = Some(nu);
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let veld = |k: &str| {
+        status.lines().find(|r| r.starts_with(k)).and_then(|r| r.split_whitespace().nth(1)).and_then(|x| x.parse::<u64>().ok()).unwrap_or(0) / 1024
+    };
+    eprintln!("FASE\t{naam}\t{dt:.3}\t{}\t{}", veld("VmRSS:"), veld("VmHWM:"));
+}
+
+/// Meetkopie: alleen lezen (ontleden en indelen in objecten en knopen), zonder hashes, en tellen.
